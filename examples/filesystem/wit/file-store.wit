package example:filesystem;

world file-store {
    import wasi:filesystem/preopens@0.3.0;
    import wasi:filesystem/types@0.3.0;

    export read: async func(name: string) -> result<string, string>;
    export write: async func(name: string, contents: string) -> result<u64, string>;
    export list-files: async func() -> result<list<string>, string>;
}
